# Dashboard + signal API (keep real values in a private .env file)
POSTGRES_PASSWORD=REPLACE_WITH_64_CHARACTER_URL_SAFE_RANDOM_PASSWORD
SIGNAL_DATABASE_URL=postgresql+psycopg://kotak:REPLACE_WITH_64_CHARACTER_URL_SAFE_RANDOM_PASSWORD@127.0.0.1:5432/kotak_live
LIVE_DATABASE_URL=postgresql+psycopg://kotak:REPLACE_WITH_64_CHARACTER_URL_SAFE_RANDOM_PASSWORD@127.0.0.1:5432/kotak_live
SIGNAL_BRIDGE_TOKEN=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DASHBOARD_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD_AT_LEAST_12_CHARACTERS
DASHBOARD_SESSION_SECRET=REPLACE_WITH_DIFFERENT_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_PUBLIC_ORIGIN=

# Keep orders disabled until account and live-session checks are complete.
LIVE_ORDERS_ALLOWED=NO
LIVE_FIXED_ENTRY_QUANTITY=
LIVE_AUTO_TRADING=NO
LIVE_ARM_TOTP_SECRET=

# Optional broker credentials; never commit actual values.
KOTAK_NEO_CONSUMER_KEY=
KOTAK_NEO_MOBILE_NUMBER=
KOTAK_NEO_UCC=
KOTAK_NEO_MPIN=
KOTAK_NEO_TOTP_SECRET=
DHAN_CLIENT_ID=
DHAN_PIN=
DHAN_TOTP_SECRET=
